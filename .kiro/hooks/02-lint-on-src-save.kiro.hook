{
  "enabled": true,
  "name": "Zero-Warning Oxlint Check on Source Save",
  "description": "Runs oxlint across the TypeScript/React studio codebase whenever any file under src/ is saved, enforcing the 0-warning / 0-error standard.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npm run lint"
  }
}
